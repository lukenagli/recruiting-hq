{
  "manifest_version": 3,
  "name": "Recruiting HQ Reader",
  "version": "1.21.0",
  "description": "Reads (never sends, replies or reacts) what's new in your Outlook email and calendar and files it in Recruiting HQ.",
  "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestFeedback"],
  "host_permissions": [
    "https://recruiting-hq.onrender.com/*",
    "https://outlook.cloud.microsoft/*",
    "https://outlook.office.com/*",
    "https://www.capitaliq.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Recruiting HQ Reader" },
  "content_scripts": [
    { "matches": ["https://outlook.cloud.microsoft/*", "https://outlook.office.com/*"], "js": ["safe.js", "outlook.js"], "run_at": "document_idle" },
    { "matches": ["https://recruiting-hq.onrender.com/*"], "js": ["bridge.js"], "run_at": "document_start" }
  ]
}
